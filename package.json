{
  "name": "pip",
  "version": "0.1.0",
  "private": true,
  "description": "Pip — offline Windows capture companion",
  "repository": {
    "type": "git",
    "url": "https://github.com/duell-dev/pip.git"
  },
  "bugs": {
    "url": "https://github.com/duell-dev/pip/issues"
  },
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts .github electron.vite.config.ts tsconfig.json package.json electron-builder.yml",
    "format:check": "prettier --check src tests scripts .github electron.vite.config.ts tsconfig.json package.json electron-builder.yml",
    "test": "pnpm build && node scripts/electron-node.cjs tests/data.cjs",
    "benchmark": "pnpm build && node scripts/electron-node.cjs tests/graph-benchmark.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "test:dev": "node tests/development.cjs",
    "test:baseline": "node tests/baseline.cjs",
    "test:packaged": "node tests/desktop.cjs --packaged",
    "package:dir": "pnpm build && electron scripts/prepare-icon.cjs && electron-builder --win --x64 --dir --publish never",
    "package:win": "pnpm build && electron scripts/prepare-icon.cjs && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  }
}
